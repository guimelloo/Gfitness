# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_app"

# JWT secret — use a long random string in production (e.g. openssl rand -base64 64)
JWT_SECRET="change-me-in-production"

# Server port
PORT=3000

# Nutrition API key (if applicable)
NUTRITION_API_KEY="your-key-here"

# Comma-separated list of allowed CORS origins (no trailing slash)
# Leave unset or set to * to allow all origins (dev only)
# Production example:
# ALLOWED_ORIGINS=https://gfitness.com.br,https://www.gfitness.com.br
ALLOWED_ORIGINS=*

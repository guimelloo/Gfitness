# Configuração de API - Use quando estiver usando ngrok

# Para ngrok, copie a URL gerada pelo ngrok (ex: https://xxxxx.ngrok.io)
# EXPO_PUBLIC_API_BASE_URL=https://xxxxx.ngrok.io

# Para desenvolvimento local (padrão)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.178.218:3000

# Para localhost em emulador iOS
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Para emulador Android
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
